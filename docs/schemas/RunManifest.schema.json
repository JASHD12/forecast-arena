{
  "additionalProperties": false,
  "description": "What one job run did, for audit and for summing LLM usage across a day.",
  "properties": {
    "batch_date": {
      "format": "date",
      "title": "Batch Date",
      "type": "string"
    },
    "code_sha": {
      "title": "Code Sha",
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "job": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Job",
      "type": "string"
    },
    "kind": {
      "const": "run",
      "default": "run",
      "title": "Kind",
      "type": "string"
    },
    "llm_usage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Llm Usage",
      "type": "object"
    },
    "package_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Package Versions",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_availability": {
      "additionalProperties": {
        "format": "date-time",
        "type": "string"
      },
      "title": "Source Availability",
      "type": "object"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "job",
    "batch_date",
    "status",
    "code_sha",
    "started_at",
    "ended_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
